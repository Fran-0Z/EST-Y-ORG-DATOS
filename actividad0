import time

n = 100
the_sum = 0

# Usamos perf_counter() para máxima precisión
timestamp_01 = time.perf_counter()

while(n > 0):
    the_sum = the_sum + n
    n = n - 1

timestamp_02 = time.perf_counter()

print(f"La suma es: {the_sum}")

# Calculamos la diferencia en microsegundos (µs)
elapsed_time = (timestamp_02 - timestamp_01) * 1e6
print(f"Tiempo de ejecución: {elapsed_time:.2f} µs")